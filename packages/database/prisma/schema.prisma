// UFC Intelligence — Prisma schema
// Mirrors the schema laid out in /docs/architecture.md §4

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
}

enum FightStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum FightMethod {
  KO
  TKO
  SUBMISSION
  DECISION_UNANIMOUS
  DECISION_SPLIT
  DECISION_MAJORITY
  DQ
  NO_CONTEST
  PENDING
}

enum UserRole {
  USER
  ADMIN
}

model WeightClass {
  id             String   @id @default(cuid())
  name           String   @unique
  weightLimitLbs Int
  isWomens       Boolean  @default(false)

  fighters Fighter[]
  fights   Fight[]
  rankings Ranking[]

  @@map("weight_classes")
}

model Fighter {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nickname      String?
  dob           DateTime?
  nationality   String?
  heightCm      Int?
  reachCm       Int?
  gym           String?
  coach         String?
  stance        String?
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  noContests    Int      @default(0)
  photoUrl      String?

  // Attribution for photoUrl when it's sourced from Wikimedia Commons
  // (see prisma/fetch-wikipedia-photos.ts) - Commons images are reused
  // under licenses (typically CC-BY/CC-BY-SA) that require crediting the
  // photographer and license, not just linking the file. Null when
  // photoUrl is unset or sourced some other way.
  photoCredit     String?
  photoLicense    String?
  photoLicenseUrl String?

  // Career averages sourced directly from the UFC Stats dataset import
  // (packages/database/prisma/import-dataset.ts). Nullable because not
  // every historical fighter has enough recorded fight-time for these.
  sigStrikesLandedPerMin Float? // SLpM
  sigStrikeAccuracyPct   Float? // Str_Acc
  sigStrikesAbsorbedPerMin Float? // SApM
  sigStrikeDefensePct    Float? // Str_Def
  takedownAvgPer15Min    Float? // TD_Avg
  takedownAccuracyPct    Float? // TD_Acc
  takedownDefensePct     Float? // TD_Def
  submissionAvgPer15Min  Float? // Sub_Avg

  // Cached from the most recent completed fight's event date at import
  // time (see import-dataset.ts) so Active/Retired filtering doesn't
  // require scanning fight history on every request.
  lastFightDate DateTime?

  // Elo can't be computed from one fighter's own fights in isolation -
  // it depends on the chronological outcome of every fight, across every
  // fighter, up to this point. That means it isn't a per-request query
  // like winRate or strikeAccuracy; it has to be walked and cached by
  // compute-elo.ts (same reasoning as lastFightDate above), then
  // recomputed whenever new results land (see sync-results.ts).
  //
  // Nullable, no default - null means "not computed" (no completed fight
  // rows to walk for this fighter; a real, known gap in the source data,
  // see ml/README.md's "Known limitation: sparse fighter records"), and
  // has to stay distinguishable from a genuine ~1500 rating a fighter
  // earned from actual fights. A non-nullable column with a 1500 default
  // couldn't tell those two states apart - every untouched fighter would
  // silently look identical to one who'd fought their way to a real
  // 1500. compute-elo.ts resets every fighter to null before recomputing,
  // so this is only ever non-null for a fighter it actually walked.
  eloRating Float?

  weightClassId String?
  weightClass   WeightClass? @relation(fields: [weightClassId], references: [id])

  fightsAsA        Fight[]          @relation("FighterA")
  fightsAsB        Fight[]          @relation("FighterB")
  fightsWon        Fight[]          @relation("FightWinner")
  fightStats       FightStat[]
  rankings         Ranking[]
  favoritedBy      UserFavorite[]
  eloHistory       EloHistory[]
  userPredictions  UserPrediction[]
  savedAsA         SavedComparison[] @relation("SavedComparisonA")
  savedAsB         SavedComparison[] @relation("SavedComparisonB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weightClassId])
  @@map("fighters")
}

model Event {
  id      String      @id @default(cuid())
  slug    String      @unique
  name    String
  date    DateTime
  venue   String?
  city    String?
  country String?
  status  EventStatus @default(UPCOMING)

  fights Fight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("events")
}

model Fight {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  weightClassId String?
  weightClass   WeightClass? @relation(fields: [weightClassId], references: [id])

  fighterAId String
  fighterA   Fighter @relation("FighterA", fields: [fighterAId], references: [id])
  fighterBId String
  fighterB   Fighter @relation("FighterB", fields: [fighterBId], references: [id])

  isTitleFight Boolean     @default(false)
  cardPosition Int         @default(0) // 1 = main event, ascending down the card
  status       FightStatus @default(SCHEDULED)
  method       FightMethod @default(PENDING)
  round        Int?
  time         String? // mm:ss within the finishing round

  winnerId String?
  winner   Fighter? @relation("FightWinner", fields: [winnerId], references: [id])

  stats           FightStat[]
  predictions     Prediction[]
  eloHistory      EloHistory[]
  userPredictions UserPrediction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([fighterAId])
  @@index([fighterBId])
  @@map("fights")
}

// One row per (fighter, fight) - the fighter's rating immediately after
// that fight resolved, in chronological order. Step 7 of the Elo plan:
// lets the fighter detail page draw a real rating-over-time chart
// without recomputing a fighter's whole history on every page load.
//
// Written by compute-elo.ts, which already walks every completed fight
// in event-date order to produce the current eloRating - capturing the
// intermediate state at each step costs almost nothing extra over
// keeping only the final value the way that script did before this.
// Like eloRating itself, this table is fully rebuilt on every run
// (deleted and reinserted), not incrementally updated - same reasoning
// the header comment on eloRating already gives: Elo is order-dependent,
// so "recompute everything" is the only version that can't silently
// drift from a bug in an incremental path.
model EloHistory {
  id String @id @default(cuid())

  fighterId String
  fighter   Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  fightId String
  fight   Fight  @relation(fields: [fightId], references: [id], onDelete: Cascade)

  // Denormalized from fight.event.date - avoids a join through Fight and
  // Event just to sort/chart this table, which is the whole point of it
  // existing instead of deriving history on demand at read time.
  eventDate DateTime
  eloAfter  Float

  @@unique([fighterId, fightId])
  @@index([fighterId, eventDate])
  @@map("elo_history")
}

model FightStat {
  id      String @id @default(cuid())
  fightId String
  fight   Fight  @relation(fields: [fightId], references: [id], onDelete: Cascade)

  fighterId String
  fighter   Fighter @relation(fields: [fighterId], references: [id])

  round Int // 0 = fight totals, 1+ = per-round

  sigStrikesLanded     Int @default(0)
  sigStrikesAttempted  Int @default(0)
  takedownsLanded      Int @default(0)
  takedownsAttempted   Int @default(0)
  controlTimeSeconds   Int @default(0)
  knockdowns           Int @default(0)
  submissionAttempts   Int @default(0)

  @@unique([fightId, fighterId, round])
  @@index([fighterId])
  @@map("fight_stats")
}

model Ranking {
  id            String @id @default(cuid())
  weightClassId String
  weightClass   WeightClass @relation(fields: [weightClassId], references: [id])

  fighterId String
  fighter   Fighter @relation(fields: [fighterId], references: [id])

  rank          Int // 0 = champion
  effectiveDate DateTime @default(now())

  @@unique([weightClassId, fighterId, effectiveDate])
  @@index([weightClassId, rank])
  @@map("rankings")
}

model Prediction {
  id      String @id @default(cuid())
  fightId String
  fight   Fight  @relation(fields: [fightId], references: [id], onDelete: Cascade)

  modelVersion String

  winnerProbabilityA Float
  winnerProbabilityB Float
  koProbability       Float
  subProbability      Float
  decisionProbability Float
  confidenceScore     Float

  topFactors Json // e.g. [{ factor: "takedown_defense", direction: "A", weight: 0.31 }]

  generatedAt DateTime @default(now())

  @@index([fightId, modelVersion])
  @@map("predictions")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  // Public handle, distinct from email - shown in the nav, on the
  // account page, and (later, Phase 5) anywhere a prediction record
  // might go public. Never derived from email so a public username
  // never leaks it. 3-20 chars, validated at the API boundary.
  username    String   @unique
  passwordHash String
  displayName String?
  role        UserRole @default(USER)

  favorites        UserFavorite[]
  savedComparisons SavedComparison[]
  resetTokens      PasswordResetToken[]
  predictions      UserPrediction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserFavorite {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fighterId String
  fighter   Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, fighterId])
  @@map("user_favorites")
}

// A saved fighter-pair from the Compare page. fighterAId/fighterBId are
// always written in canonical order (lower fighter.id first) so "A vs B"
// and "B vs A" collapse to the same saved row - the composite key would
// otherwise let a user save the same pair twice in reversed order.
model SavedComparison {
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fighterAId String
  fighterA   Fighter @relation("SavedComparisonA", fields: [fighterAId], references: [id], onDelete: Cascade)
  fighterBId String
  fighterB   Fighter @relation("SavedComparisonB", fields: [fighterBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, fighterAId, fighterBId])
  @@map("saved_comparisons")
}

// One-time-use, short-lived tokens for the forgot/reset-password flow.
// Only the SHA-256 hash of the token is ever stored - same reasoning as
// passwordHash itself: a DB read (backup leak, admin query, etc.) should
// never hand over something usable to reset an account, only bcrypt/
// sha256 output. The raw token exists only in the emailed/returned link,
// never persisted.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Deliberately NOT the same as the existing (unused) Prediction model
// above - that one is the ML model's own cached output, keyed by
// fightId + modelVersion, with no userId anywhere. This is a real
// person's pick on a real scheduled fight.
//
// No LOCKED value in the status enum on purpose - "is this still
// pickable" is derived at read/write time from comparing the fight's
// event date to now (same pattern events/fights already use for
// UPCOMING/LIVE/COMPLETED display status - see event-status.ts),
// not a value written by a cron sweep. The API surfaces "Locked" to
// the user by computing it, never by storing it. WON/LOST/VOID are
// the only transitions actually written to this column, both done by
// sync-results.ts in the same transaction where it resolves the real
// Fight row - see that file for the grading logic.
enum UserPredictionStatus {
  OPEN
  WON
  LOST
  VOID
}

model UserPrediction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fightId String
  fight   Fight  @relation(fields: [fightId], references: [id], onDelete: Cascade)

  pickedFighterId String
  pickedFighter   Fighter @relation(fields: [pickedFighterId], references: [id])

  status UserPredictionStatus @default(OPEN)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  // One pick per user per fight, enforced at the DB level - the API
  // still checks eligibility/locking before writing, but this is the
  // real guard against a race (two near-simultaneous requests) ever
  // producing two rows for the same (user, fight).
  @@unique([userId, fightId])
  @@index([fightId])
  @@index([userId])
  @@map("user_predictions")
}
