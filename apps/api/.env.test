# Dedicated local test database — same Postgres container as dev (port
# 5437), separate database name. `npm test` loads this explicitly so a
# local test run can never fall through to packages/database/.env's dev
# DATABASE_URL, the way it silently did once already (see git history /
# the fighters.service.spec.ts safety guard for why this file exists).
DATABASE_URL="postgresql://ufc:ufc_local_dev@localhost:5437/ufc_intelligence_test?schema=public"
